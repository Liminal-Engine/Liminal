@startuml rhi
namespace rhi {
    namespace __private {
        namespace __registry {
            class __Mesh {
                .. Constructors/Destructors ..
                + __Mesh(void)
                + ~__Mesh()
                .. Methods ..
                + getHandle(const std::string &name) const: const def::Handle
                + getResource(resource::Handle handle) const: const resource::Mesh *
                + exists(const std::string &name) const: bool
                + add(const std::string &name, const std::vector<def::Vertex> &vertices, const std::vector<uint32_t> &indices): Status
                .. Members ..
                - __data: std::vector<std::unique_ptr<resource::Mesh>>
                - __lookupTable: std::unordered_map<std::string, def::Handle>
            }

            class __Shader {
                .. Constructors/Destructors ..
                + __Shader(void)
                + ~__Shader()
                .. Methods ..
                + exists(const std::string &name) const: bool
                + getHandle(const std::string &name) const: def::Handle
                + getResource(def::Handle handle) const: const resource::Shader *
                + add(const std::string &name, const std::string &vertexSource, const std::string &geometrySource, const std::string &fragmentSource, const std::string &computeSource): Status
                .. Members ..
                - __data: std::vector<std::unique_ptr<resource::Shader>>
                - __lookupTable: std::unordered_map<std::string, def::Handle>
            }

            class __Texture {
                .. Constructors/Destructors ..
                + __Texture(void)
                + ~__Texture()
                .. Methods ..
                + getHandle(const std::string &name) const: def::Handle
                + getResource(def::Handle handle) const: const resource::Texture *
                + exists(const std::string &name) const: bool
                + add(const std::string &name, const unsigned char* data, const glm::ivec2 &size, int nChannels): Status
                .. Members ..
                - __data: std::vector<std::unique_ptr<resource::Texture>>
                - __lookupTable: std::unordered_map<std::string, def::Handle> 
            }
        }

        
    }

    namespace resource {
        

        class Mesh {
            .. Constructors/Destructors ..
            + Mesh(const std::vector<Vertex> &vertices, const std::vector<uint32_t> &indices)
            + ~Mesh()
            + Mesh(const Mesh &) = delete
            + Mesh& operator=(const Mesh &) = delete
            + Mesh(Mesh &&) = delete
            + Mesh& operator=(Mesh &&) = delete
            .. Methods ..
            + draw_DELETE_ME_I_AM_NOT_SUPPOSED_TO_DRAW_MYSELF(void) const: void
            .. Members ..
            - __VAO: uint32_t
            - __EBO: uint32_t
            - __VBO: uint32_t
            - __count: uint32_t
        }

        class Shader {
            .. Constructors/Destructors ..
            + Shader(const std::string &vertexSource, const std::string &geometrySource, const std::string &fragmentSource, const std::string &computeSource)
            + ~Shader()
            + Shader(const Shader &) = delete
            + Shader& operator=(const Shader &) = delete
            + Shader(Shader &&) = delete
            + Shader& operator=(Shader &&) = delete
            .. Methods ..
            + use(void) const: void
            + getUniforms(void) const: const std::vector<def::Uniform> &
            - {static} __compileShaderSource(const std::string &source, def::ShaderType type): uint32_t
            - {static} __loadProgram(const std::string &vertexSource, const std::string &geometrySource, const std::string &fragmentSource, const std::string &computeSource): uint32_t
            .. Members ..
            - __glHandle: uint32_t
            - __uniforms: std::vector<def::Uniform>

        }

        class Texture {
            .. Constructors/Destructors ..
            +Texture(const unsigned char *data, const glm::ivec2 &size, int nChannels)
            + ~Texture()
            + Texture(const Texture&) = delete;
            + Texture& operator=(const Texture&) = delete
            + Texture(Texture&&) = delete;
            + Texture& operator=(Texture&&) = delete;
            - {static} __loadTexture(const unsigned char *data, const glm::ivec2 &size, int nChannels): uint32_t
            .. Members ..
            - __glHandle: uint32_t
        }
    }

    namespace def {
        class "uint32_t" as u32 <<primitive>>
        class Handle <<using>>
        Handle ..> u32 : type alias

        struct Vertex {
            .. Members ..
            + position: glm::vec3
            + uv: glm::vec2
            + normal: glm::vec3
        }

        enum ShaderType {
            VERTEX,
            GEOMETRY,
            FRAGMENT,
            COMPUTE
        }

        struct Uniform {
            .. Constructors/Destructors ..
            + Uniform(const std::string &name, GLint location, GLenum type)
            .. Members ..
            + name: const std::string
            + location: const GLint
            + type: const GLenum
        }
    }

    enum Status {
        N_OK,
        E_ALREADY_INIT,
        E_NOT_INIT,
        E_ALREADY_EXISTS
    }
}
@enduml